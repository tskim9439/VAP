# ============================================================================
# VAP-ASR 실험 환경 — 단일 관리 파일
# ============================================================================
# 이 파일은 Git 에 커밋된다. **비밀정보(비밀번호·API 키·토큰)를 넣지 말 것.**
# 머신별로 다른 값이 필요하면 .env.local 에 덮어쓴다 (gitignored).
#
# 사용:
#   shell   : set -a; source .env; set +a
#   python  : from dotenv import load_dotenv; load_dotenv()
#   scripts : scripts/sync-rack4.sh 가 자동으로 읽는다
#
# 마지막 검증: 2026-09-03 (scripts/sync-rack4.sh status 로 재확인)
# ============================================================================

# ── 학습 서버 ───────────────────────────────────────────────────────────────
# SSH alias. ~/.ssh/config 의 Host 항목과 일치해야 한다.
REMOTE_HOST=rack4
REMOTE_USER=tskim
REMOTE_HOSTNAME=rack4-a100

# ── Docker ─────────────────────────────────────────────────────────────────
# 모든 학습은 이 컨테이너 안에서 수행한다.
# 컨테이너 IP 는 재시작 때마다 바뀌므로 SSH 직결 대신 docker exec 를 쓴다.
DOCKER_CONTAINER=tskim_env
DOCKER_IMAGE=tskim_docker:v1

# ── 프로젝트 (로컬 ↔ 원격 동기화 대상) ──────────────────────────────────────
# 로컬 경로는 저장소 위치에서 자동 유도되므로 여기 두지 않는다.
# /home 은 컨테이너에 bind mount 되어 있어 호스트와 컨테이너가 같은 경로를 본다.
REMOTE_PROJECT_DIR=/home/tskim/VAP

# ── 체크포인트 (/data4) ────────────────────────────────────────────────────
# 주의: /data4 는 15T 중 97% 사용 중(2026-09-03 기준 약 575G 여유).
#       대용량 중간 산출물은 /data3 로 보낸다.
CKPT_ROOT=/data4/tskim/VAPASR
CKPT_EXP_DIR=/data4/tskim/VAPASR/experiments
CKPT_EXPORT_DIR=/data4/tskim/VAPASR/exports

# ── 데이터 (/data3) ────────────────────────────────────────────────────────
# 3.5T 중 2.5T 여유(2026-09-03 기준). 원천 코퍼스와 특징 캐시는 여기에 둔다.
DATA_ROOT=/data3/tskim
DATA_CORPORA_DIR=/data3/tskim/corpora
DATA_FEATURE_CACHE_DIR=/data3/tskim/features
DATA_MANIFEST_DIR=/data3/tskim/manifests
DATA_LOG_DIR=/data3/tskim/logs

# ── 하드웨어 ───────────────────────────────────────────────────────────────
# rack4-a100: NVIDIA A100-PCIE-40GB × 4. 공용 서버이므로 점유 전 nvidia-smi 확인.
GPU_TYPE=A100-PCIE-40GB
GPU_COUNT=4
# 오늘 배정된 GPU 번호는 .env.local 의 GPU_DEFAULT 에 둔다 (날마다 바뀜). activate-env.sh 가 CUDA_VISIBLE_DEVICES 기본값으로 쓴다.

# ── 동기화 정책 ────────────────────────────────────────────────────────────
# 로컬이 정본(source of truth)이다. push 는 원격을 로컬에 맞춰 덮어쓴다.
# 원격에서 생긴 산출물은 프로젝트 폴더가 아니라 CKPT_ROOT / DATA_ROOT 에 둔다.
SYNC_DIRECTION=local-to-remote
SYNC_EXCLUDE_FILE=.rsyncignore

# ── 캐시 / 실행 환경 (컨테이너) ────────────────────────────────────────────
# 모델 가중치·데이터셋 캐시는 /root 가 아니라 /data3 로. 컨테이너 재생성 시에도 남는다.
CONDA_ENV_NAME=vapasr
CONDA_PYTHON=3.11
CACHE_ROOT=/data3/tskim/cache
HF_HOME=/data3/tskim/cache/huggingface
NEMO_CACHE_DIR=/data3/tskim/cache/nemo
TORCH_HOME=/data3/tskim/cache/torch

# ── AI Hub ─────────────────────────────────────────────────────────────────
# 감정이 태깅된 자유대화: 성인 71631 / 청소년 71632. 내국인 본인인증 + 활용 신청 승인 필요.
# 이 데이터셋은 API 키 발급 불가·PC 다운로드만 가능(2026-09-03) → 맥에서 받아 scripts/aihub-upload.sh 로 전송.
# (API 가 열리는 다른 데이터셋용) 키는 .env.local 에 AIHUB_API_KEY=... (gitignored)
AIHUB_DATASET_ADULT=71631
AIHUB_DATASET_TEEN=71632
AIHUB_DOWNLOAD_DIR=/data3/tskim/corpora/aihub
# 한글·괄호 경로를 피하기 위한 심볼릭 링크 (→ .../01-1.정식개방데이터)
AIHUB_ADULT_ROOT=/data3/tskim/corpora/aihub/adult

# ============================================================================
# mxc (Azure CycleCloud, H200 × 8) — 2026-09-04 추가
# ============================================================================
# rack4 와 병행해서 쓰는 두 번째 학습 환경. 위쪽 rack4 설정은 그대로 두고,
# mxc 쪽은 전부 MXC_ 접두사로 분리한다. scripts/sync-mxc.sh 가 읽는다.
#
# 스토리지 두 종류를 용도로 나눈다:
#   /soundai  NFS·아카이브 5.0P (여유 충분, 상대적으로 느림)  → 프로젝트 폴더·산출물 보관
#   /lustre   Lustre 504T (90% 사용, 여유 51T, 빠름)          → 체크포인트·데이터·캐시
MXC_REMOTE_HOST=mxc
MXC_REMOTE_USER=sa_tskim
MXC_REMOTE_HOSTNAME=ip-0AF92108

# ── Docker ─────────────────────────────────────────────────────────────────
# 컨테이너 IP 는 재시작마다 바뀌므로 SSH 직결(mxc_sa_tskim, 172.17.0.10)은 쓰지 않는다.
# 실제 IP 는 172.17.0.19 (2026-09-04). 항상 `ssh mxc docker exec sa_tskim ...` 경로를 쓴다.
# /soundai 와 /lustre 는 컨테이너에 같은 경로로 bind mount 되어 있다.
MXC_DOCKER_CONTAINER=sa_tskim
MXC_DOCKER_IMAGE=fullduplex:260714

# ── 프로젝트 (로컬 ↔ 원격 동기화 대상) ──────────────────────────────────────
MXC_REMOTE_PROJECT_DIR=/soundai/users/tskim/VAPKT

# ── 체크포인트 / 데이터 (Lustre) ───────────────────────────────────────────
MXC_CKPT_ROOT=/lustre/soundai/users/tskim/VAPKT/ckpt
MXC_CKPT_EXP_DIR=/lustre/soundai/users/tskim/VAPKT/ckpt/experiments
MXC_CKPT_EXPORT_DIR=/lustre/soundai/users/tskim/VAPKT/ckpt/exports
MXC_DATA_ROOT=/lustre/soundai/users/tskim/VAPKT/data
MXC_DATA_CORPORA_DIR=/lustre/soundai/users/tskim/VAPKT/data/corpora
MXC_DATA_FEATURE_CACHE_DIR=/lustre/soundai/users/tskim/VAPKT/data/features
MXC_DATA_MANIFEST_DIR=/lustre/soundai/users/tskim/VAPKT/data/manifests
MXC_DATA_LOG_DIR=/lustre/soundai/users/tskim/VAPKT/data/logs

# ── 캐시 ───────────────────────────────────────────────────────────────────
MXC_CACHE_ROOT=/lustre/soundai/users/tskim/VAPKT/cache
MXC_HF_HOME=/lustre/soundai/users/tskim/VAPKT/cache/huggingface
MXC_TORCH_HOME=/lustre/soundai/users/tskim/VAPKT/cache/torch

# ── 하드웨어 ───────────────────────────────────────────────────────────────
# NVIDIA H200 141GB × 8, CPU 96코어, RAM 1.8T. 공용 서버 — 점유 전 nvidia-smi 확인.
MXC_GPU_TYPE=H200
MXC_GPU_COUNT=8

# ── 대용량 전송 (azcopy) ───────────────────────────────────────────────────
# 코드·위키 같은 소량 텍스트는 rsync 로 충분하다(전체 1.3MB, 수 초).
# 코퍼스·체크포인트처럼 GB~TB 급을 옮길 때는 azcopy 가 훨씬 빠르다(병렬 전송).
#   서버측: /usr/bin/azcopy 10.32.3 설치됨.
#   로컬(맥): 미설치 → `brew install azcopy` 후 사용.
# 인증에 스토리지 계정 SAS URL 이 필요하다. SAS 는 비밀정보이므로
# .env.local 에 MXC_AZCOPY_SAS_URL=... 로 두고 절대 커밋하지 않는다.
# /soundai 백엔드 스토리지 계정: staz02archivemxc007 (NFS 마운트 10.161.100.103)
MXC_AZCOPY_STORAGE_ACCOUNT=staz02archivemxc007
# Blob 컨테이너 URL = https://<계정>.blob.core.windows.net/<컨테이너>
# /soundai 마운트가 곧 이 컨테이너다 → /soundai/users/tskim/VAPKT 는
# Blob 상의 users/tskim/VAPKT 와 같은 곳이라 azcopy 가 한 번에 닿는다.
MXC_AZCOPY_CONTAINER=soundai

# ── conda 환경 (2026-09-04 구축) ────────────────────────────────────────────
# 컨테이너 / 는 2.0T 중 97% 사용(여유 67G)이라 env 를 Lustre 에 둔다.
# 활성화: source $MXC_CONDA_DIR/etc/profile.d/conda.sh && conda activate vapasr
# 구성: python 3.11.16 / torch 2.9.0+cu128 / nemo_toolkit 3.1.0+6989ae9fc(git main)
#       transformers 4.57.6 / qwen-asr 0.0.6 / peft 0.20.0
MXC_CONDA_DIR=/lustre/soundai/users/tskim/VAPKT/conda
MXC_CONDA_ENV_NAME=vapasr
MXC_NEMO_CACHE_DIR=/lustre/soundai/users/tskim/VAPKT/cache/nemo

# ── 모델 (공용 모델 저장소) ────────────────────────────────────────────────
# /soundai/Model 은 팀 공용이다. 다른 사람의 모델을 건드리지 않는다.
# 스모크 테스트 통과 2026-09-04: Nemotron 79.6 ms/frame·d_model 1024,
# Qwen audio_tower 186M, ForcedAligner 한국어 정렬 0.08 s 해상도.
MXC_MODEL_DIR=/soundai/Model
MXC_NEMOTRON_DIR=/soundai/Model/nemotron-3.5-asr-streaming-0.6b
MXC_QWEN_ASR_DIR=/soundai/Model/Qwen3-ASR-0.6B
MXC_ALIGNER_DIR=/soundai/Model/Qwen3-ForcedAligner-0.6B

# ── 망 제약 (2026-09-04 실측) ──────────────────────────────────────────────
# 사내망 SSL 검사가 일부 CDN 을 끊는다. 프론트 도메인은 200 인데 실제 파일
# 호스트에서 UNEXPECTED_EOF 가 나므로 원인을 오해하기 쉽다. 차단 확인:
#   repo.anaconda.com / micro.mamba.pm / download-r2.pytorch.org / librosa.org
# 우회: conda 는 conda-forge/miniforge(github.com), torch 는 PyPI 휠
#      (--index-url download.pytorch.org 금지), 예제 오디오는 서버 내 wav 사용.
# 정상: github.com / conda.anaconda.org / pypi.org / files.pythonhosted.org
#      / huggingface.co
